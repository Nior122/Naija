# Naija: One World - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Database Configuration (Neon PostgreSQL)
# Use a disposable development/test database for local and CI runs. Never point this at real player data.
# Prefer sslmode=verify-full so the certificate is verified explicitly.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Certificate verification is ON by default. DB_SSL_REJECT_UNAUTHORIZED=false is allowed ONLY when NAIJA_ENV is
# development or test (for a private test CA). It is refused in production.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Live database tests (test/database.test.mjs, test/postgres-persistence.test.mjs)
# require this explicit opt-in. They write test rows, apply additive migrations, and create/remove
# rows under t28-* keys. Point them only at a disposable database.
# NAIJA_ALLOW_DB_TESTS=true

# Runtime environment. REQUIRED: the server refuses to start if this is unset or invalid.
# production:  PostgreSQL only; verified TLS only; metrics must be protected (see docs/STAGE_28_CONFIGURATION.md).
# development: local work. File persistence only if PERSISTENCE_BACKEND=file is set explicitly.
# test:        automated tests. Tests must use a temporary world file, never data/world-state.json.
# Local development: uncomment the next line in your own .env (do not set it in a production environment).
# NAIJA_ENV=development

# Persistence backend for the world state: "postgres" or "file".
# Production: "postgres" is required; "file" is refused, and DATABASE_URL must be set.
# Development and test: with neither PERSISTENCE_BACKEND nor DATABASE_URL, the server refuses to start.
#   There is no automatic fallback to the JSON file, and a failed PostgreSQL connection never falls back to it.
# "postgres" also refuses to start if the database is unreachable or not migrated (npm run db:migrate).
# "file" is single-instance development mode only and is reported as NOT PostgreSQL in /health.
# PERSISTENCE_BACKEND=postgres

# Metrics access for /metrics and /metrics/prometheus. REQUIRED in production (no default).
# token:    requests need "Authorization: Bearer <NAIJA_METRICS_TOKEN>". The token must be at least 32 characters.
# ingress:  the application does not check access. The ingress MUST block these paths from the public internet.
# disabled: both paths return 404.
# open:     development and test only. Refused in production.
# NAIJA_METRICS_ACCESS=open
# NAIJA_METRICS_TOKEN=          # set a long random value from your secret store; never commit it

# Alternative: Individual database configuration (if DATABASE_URL not used)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=naija_world
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_MAX_CONNECTIONS=20
# DB_SSL=true            # TLS on (default). DB_SSL=false is allowed ONLY when NAIJA_ENV is development or test,
                         # and ONLY to a loopback host (127.0.0.1, ::1, or localhost resolving only to loopback).
                         # It is refused for any remote host and in production. PGHOSTADDR and the
                         # host/hostaddr URL parameters are refused.
                         # DB_SSL=false conflicts with any verifying sslmode in DATABASE_URL, and
                         # sslmode=disable in DATABASE_URL requires DB_SSL=false.

# Server Configuration
PORT=8080
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Multiplayer Configuration
TICK_INTERVAL_MS=50
MAX_MESSAGE_BYTES=8192

# Allowed origins for WebSocket connections (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
