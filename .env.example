# Optional local overrides for the Naija world API and prototype WebSocket server.
PORT=3000
# Relative paths are resolved from services/world-api/; the file is atomically replaced on save.
DATA_FILE=data/world-state.json
WS_PATH=/ws
# Required for browser-origin WebSocket clients; desktop Godot clients usually omit Origin.
# Example: ALLOWED_ORIGINS=https://naija.example,https://play.naija.example
ALLOWED_ORIGINS=
# Optional milliseconds per in-game minute (1–60000); defaults to 650 for the shared world clock.
# GAME_MINUTE_MS=650
