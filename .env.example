# Naija: One World - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Database Configuration (Neon PostgreSQL)
# Use a disposable development/test database for local and CI runs. Never point this at real player data.
# Prefer sslmode=verify-full so the certificate is verified explicitly.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Certificate verification is ON by default. Set to false ONLY for a private test CA.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Live database tests (test/database.test.mjs, test/postgres-persistence.test.mjs)
# require this explicit opt-in. They write test rows, apply additive migrations, and create/remove
# rows under t28-* keys. Point them only at a disposable database.
# NAIJA_ALLOW_DB_TESTS=true

# Persistence backend for the world state: "postgres" or "file".
# Unset: "postgres" when DATABASE_URL is set, otherwise "file".
# "postgres" refuses to start if the database is unreachable or not migrated (npm run db:migrate).
# "file" is single-instance development mode only and is reported as NOT PostgreSQL in /health.
# PERSISTENCE_BACKEND=postgres

# Alternative: Individual database configuration (if DATABASE_URL not used)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=naija_world
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_MAX_CONNECTIONS=20
# DB_SSL=true            # TLS on (default). Set DB_SSL=false ONLY for a local server without TLS.
                         # DB_SSL=false conflicts with any verifying sslmode in DATABASE_URL, and
                         # sslmode=disable in DATABASE_URL requires DB_SSL=false.

# Server Configuration
PORT=8080
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Multiplayer Configuration
TICK_INTERVAL_MS=50
MAX_MESSAGE_BYTES=8192

# Allowed origins for WebSocket connections (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
