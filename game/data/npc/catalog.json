      "decision_interval_minutes": 30,
      "max_active_npcs_per_tick": 100,
      "needs_decay_rate_per_hour": {
        "hunger": 5.0,
        "rest": 3.0,
        "social": 2.0,
        "safety": 0.5,
        "income_satisfaction": 1.0,
        "housing_satisfaction": 0.5,
        "health": 0.2
      }
    },
    "needs": {
      "thresholds": {
        "critical": 20,
        "low": 40,
        "moderate": 60,
        "high": 80
      },
      "satisfaction_rates": {
        "hunger_per_meal": 50,
        "rest_per_night": 80,
        "social_per_interaction": 30,
        "health_per_medical_visit": 40
      }
    },
